# Copy to .env, or generate a filled-in one with: python run.py --init
SECRET_KEY=replace-with-64-hex-chars
MASTER_KEY=replace-with-base64url-of-32-random-bytes
STORAGE_DIR=storage
DATABASE_PATH=storage/vault.db
MAX_UPLOAD_MB=200
DEFAULT_LINK_TTL_HOURS=24
MAX_LINK_TTL_HOURS=720
# Set to 1 when serving over HTTPS
COOKIE_SECURE=0
